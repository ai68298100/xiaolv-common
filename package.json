{
  "name": "xiaolv-common",
  "version": "0.3.0",
  "description": "SiYuan plugin: quick recall and reuse of common content anchored to real SiYuan blocks.",
  "main": "index.js",
  "scripts": {
    "dev": "webpack --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "check": "tsc --noEmit",
    "test": "node tests/run-tests.cjs",
    "test:ui": "node scripts/render-production.cjs",
    "e2e": "node scripts/e2e-acceptance.cjs",
    "scan": "node scripts/secret-scan.cjs"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "snippets",
    "common-phrases",
    "小驴常用"
  ],
