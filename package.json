  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.4.3",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "^1.63.0",
    "sass": "^1.105.0",
    "sass-loader": "^17.0.0",
    "siyuan": "1.2.9",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.0.3",
    "zip-webpack-plugin": "^4.0.3"
  },
  "dependencies": {
    "tiny-pinyin": "^1.3.2"
  }
