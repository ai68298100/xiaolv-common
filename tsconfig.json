{
  "compilerOptions": {
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es2019",
    "strictNullChecks": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["dom", "es2021"],
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts"
  ]
}
